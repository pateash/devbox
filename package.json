{
  "name": "devbox",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first developer attention workspace",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u NODE_OPTIONS electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@tanstack/react-query": "^5.66.0",
    "better-sqlite3": "^11.8.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.51.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.devbox.app",
    "productName": "DevBox",
    "icon": "resources/devbox-icon.png",
    "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools", "hardenedRuntime": true },
    "dmg": { "sign": false },
    "afterSign": "./scripts/notarize.cjs"
  }
}
